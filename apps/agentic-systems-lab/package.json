{
  "name": "@erik-florida/agentic-systems-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others 'next dev --hostname 127.0.0.1 --port 3100' 'tsx watch scripts/review-worker.ts'",
    "build": "next build",
    "start": "concurrently --kill-others 'next start --hostname 127.0.0.1 --port 3100' 'tsx scripts/review-worker.ts'",
    "worker": "tsx scripts/review-worker.ts",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@mastra/core": "1.74.0",
    "next": "16.3.4",
    "openai": "^7.13.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@erik-florida/eslint-config": "workspace:*",
    "@erik-florida/typescript-config": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
